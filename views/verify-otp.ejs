<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title>Verify OTP | AK Fabrics</title>
</head>
<body>
    <form action="/auth/verify-otp" method="POST">
        <h2>Verification</h2>
        <p style="font-size: 13px; color: #94A3B8; margin-bottom: 20px;">Enter the code sent to your email.</p>
        <input type="text" name="otp" placeholder="Enter OTP" autofocus required/>
        <button type="submit">Verify Code</button>
        <div class="btn-row" style="justify-content: center;">
            <a href="/auth/forget-password">Didn't receive it? Resend</a>
        </div>
    </form>
</body>
</html>