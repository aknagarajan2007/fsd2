<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title>New Password | AK Fabrics</title>
</head>
<body>
    <form action="/auth/change-password" method="POST">
        <h2>New Password</h2>
        <input type="password" name="newpassword" placeholder="New Password" autofocus required/>
        <input type="password" name="confirm-password" placeholder="Confirm New Password" required/>
        <button type="submit">Update Password</button>
    </form>
</body>
</html>