<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title>Reset Password | AK Fabrics</title>
</head>
<body>
    <form action="/auth/forget-password" method="POST">
        <h2>Recover Account</h2>
        <p style="font-size: 13px; color: #94A3B8; margin-bottom: 20px;">Enter your email to receive a verification code.</p>
        <input type="email" name="email" placeholder="Email Address" autofocus required/>
        <button type="submit">Send OTP</button>
        <div class="btn-row" style="justify-content: center;">
            <a href="/auth/login">Back to Login</a>
        </div>
    </form>
</body>
</html>