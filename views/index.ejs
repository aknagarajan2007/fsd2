
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#000000">

    <title>AK Fabrics | Elegance in Every Thread</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --black: #000000;
            --charcoal: #2E2E2E;
            --cream: #F5F1E6;
            --terracotta: #8B2E1F;
            --forest: #0B3D2E;
            --gold: #D4AF37;
            --red: #E50914;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scrollbar-width: none;
        }

        body {
            min-height: 100vh;
            background: var(--black);
            color: var(--cream);
            font-family: 'Montserrat', sans-serif;
        }

        .background {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background:url('home.png') center/cover no-repeat;
        }

        header, footer {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 30px 60px;
        }

        .logo, h1 {
            font-family: 'Cinzel', serif;
            letter-spacing: 3px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 600;
        }

        .logo span {
            color: var(--gold);
        }

        .line {
            width: 55px;
            height: 1px;
            flex-shrink: 0;
            background: var(--gold);
            opacity: .7;
        }

        header p, footer p {
            display: flex;
            align-items: center;
            gap: 14px;
            color: var(--cream);
            font-size: .7rem;
            letter-spacing: 4px;
        }

        main {
            flex: 1;
            display: grid;
            place-items: center;
            padding: 30px 20px;
        }

        /* GLASS CARD */

        .glass {
            position: relative;
            width: min(750px, 100%);
            padding: 65px 55px;
            text-align: center;
            background: linear-gradient(
                145deg,
                rgba(46, 46, 46, 0.41),
                rgba(0, 0, 0, 0.485)
            );
            backdrop-filter: blur(16px) saturate(140%);
            -webkit-backdrop-filter: blur(16px) saturate(140%);
            border: 1px solid rgba(212, 175, 55, .35);
            border-radius: 30px;
            box-shadow:
                0 35px 80px #000b,
                0 15px 35px #0008,
                inset 0 1px 10px #d4af3726,
                inset 0 -6px 12px #0008,
                0 0 30px #d4af370f;
            transform: perspective(1200px) translateY(-5px);
            transition: .4s ease;
            overflow: hidden;
        }

        .glass::before {
            content: "";
            position: absolute;
            top: 0;
            left: 10%;
            width: 80%;
            height: 1px;
            background: linear-gradient(
                90deg, transparent, var(--gold), transparent
            );
        }

        .glass:hover {
            transform: perspective(1200px) translateY(-12px);
            box-shadow:
                0 45px 90px #000c,
                0 0 35px #d4af3720,
                inset 0 1px 10px #d4af3733;
        }

        .subtitle {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 25px;
            color: var(--gold);
            font-size: .7rem;
            letter-spacing: 4px;
        }

        h1 {
            margin-bottom: 22px;
            color: var(--gold);
            font-size: clamp(2.2rem, 7vw, 4.5rem);
            font-weight: 600;
            letter-spacing: 5px;
            text-shadow: 0 5px 20px #000b;
        }

        .glass > p {
            max-width: 550px;
            margin: 0 auto 42px;
            color: var(--cream);
            font-size: .9rem;
            font-weight: 300;
            line-height: 1.9;
            opacity: .85;
        }

        /* BUTTONS */

        .buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .buttons a {
            min-width: 220px;
            padding: 15px 25px;
            border: 1px solid var(--gold);
            border-radius: 4px;
            color: var(--cream);
            font-size: .75rem;
            font-weight: 500;
            letter-spacing: 2px;
            text-decoration: none;
            text-align: center;
            transition: .3s ease;
        }

        .buttons a:first-child {
            background: var(--forest);
        }

        .buttons a:last-child {
            background: var(--terracotta);
            border-color: var(--terracotta);
        }

        .buttons a:hover {
            background: var(--gold);
            color: var(--black);
            border-color: var(--gold);
            transform: translateY(-4px);
            box-shadow: 0 8px 25px #d4af3733;
        }

        .buttons a:last-child:hover {
            background: var(--red);
            color: var(--cream);
            border-color: var(--red);
        }

        /* FOOTER */

        footer {
            justify-content: center;
            gap: 20px;
        }

        footer p {
            gap: 12px;
        }

        /* MOBILE PORTRAIT */

        @media (max-width: 600px) and (orientation: portrait) {

            header {
                padding: 22px 16px;
            }

            .logo {
                font-size: 1rem;
                letter-spacing: 2px;
            }

            header p {
                font-size: .48rem;
                letter-spacing: 1px;
                gap: 6px;
            }

            header .line {
                width: 18px;
            }

            main {
                padding: 20px 15px;
            }

            .glass {
                padding: 42px 18px;
                border-radius: 22px;
                transform: none;
            }

            .glass:hover {
                transform: translateY(-5px);
            }

            .subtitle {
                gap: 8px;
                margin-bottom: 22px;
                font-size: .5rem;
                letter-spacing: 1.5px;
            }

            .subtitle .line {
                width: 20px;
            }

            h1 {
                font-size: clamp(2rem, 9vw, 2.7rem);
                letter-spacing: 2px;
                margin-bottom: 18px;
            }

            .glass > p {
                font-size: .78rem;
                line-height: 1.8;
                margin-bottom: 28px;
            }

            .buttons {
                flex-direction: column;
                gap: 12px;
            }

            .buttons a {
                width: 100%;
                min-width: 0;
                padding: 14px;
                font-size: .7rem;
            }

            footer {
                padding: 20px 12px;
                gap: 10px;
            }

            footer p {
                gap: 7px;
                font-size: .52rem;
                letter-spacing: 1.5px;
            }

            footer .line {
                width: 23px;
            }
        }

        /* SMALL MOBILE PORTRAIT */

        @media (max-width: 380px) and (orientation: portrait) {

            header {
                padding: 18px 12px;
            }

            .logo {
                font-size: .9rem;
            }

            header p {
                font-size: .42rem;
            }

            .glass {
                padding: 35px 15px;
            }

            .subtitle {
                font-size: .44rem;
                gap: 6px;
            }

            .subtitle .line {
                width: 16px;
            }

            h1 {
                font-size: 2rem;
            }

            .glass > p {
                font-size: .73rem;
            }

            footer p {
                font-size: .46rem;
                letter-spacing: 1px;
            }
        }
    </style>
</head>

<body>

<div class="background">

    <header>
        <div class="logo">AK <span>FABRICS</span></div>
        <p><span class="line"></span> EST. WITH QUALITY</p>
    </header>

    <main>
        <section class="glass">

            <div class="subtitle">
                <span class="line"></span>
                ELEGANCE IN EVERY THREAD
                <span class="line"></span>
            </div>

            <h1>AK FABRICS</h1>

            <p>
                Discover the perfect blend of quality, style and craftsmanship.
                Welcome to AK FABRICS, where every thread tells a story of excellence.
            </p>

            <div class="buttons">
                <a href="/auth/login">SIGN UP</a>
                <a href="/fabrics">EXPLORE FABRICS</a>
            </div>

        </section>
    </main>

    <footer>
        <span class="line"></span>
        <p>QUALITY &bull; STYLE &bull; ELEGANCE</p>
        <span class="line"></span>
    </footer>

</div>

</body>
</html>
