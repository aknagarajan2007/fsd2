<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- Locks viewport to a desktop width so mobile browsers render the desktop version -->
    <meta name="viewport" content="width=1280">
    <meta name="theme-color" content="#101C16">
    
    <!-- Primary Meta Tags -->
    <title>AK FABRICS | Premium Textiles</title>
    <meta name="title" content="AK FABRICS | Premium Textiles">
    <meta name="description" content="Discover the perfect blend of quality, style, and craftsmanship. Welcome to AK FABRICS, where every thread tells a story of excellence.">
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="AK FABRICS | Premium Textiles">
    <meta property="og:description" content="Elegance in every thread. Explore our premium collections of high-quality fabrics.">
    <meta property="og:image" content="/img/og-image.jpg"> <!-- Update with your actual OG image path -->

    <!-- Performance: Preconnect to font domains to speed up text rendering -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Favicon (Update with your actual favicon path) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <style>
        :root {
            --gold: #C9A76B;
            --green: #101C16;
            --darkgold: #c89721;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
        
        /* Hide scrollbar for Chrome, Safari and Opera */
        html::-webkit-scrollbar {
            display: none;
        }

        body {
            min-height: 100vh;
            background-color: var(--green);
            color: white;
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            min-width: 1280px; /* Forces desktop minimum width */
            -webkit-font-smoothing: antialiased; /* Crisp font rendering */
            -moz-osx-font-smoothing: grayscale;
        }

        /* --- ANIMATIONS --- */
        @keyframes intro {
            0% {
                opacity: 0;
                transform: scale(3);
                filter: blur(30px);
            }
            40%, 60% {
                opacity: 1;
                transform: scale(1);
                filter: blur(0);
            }
            100% {
                opacity: 0;
                transform: scale(.5);
                display: none;
            }
        }

        @keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(50px);
                filter: blur(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }

        @keyframes zoom {
            from {
                opacity: 0;
                transform: scale(1.5);
                filter: blur(10px);
            }
            to {
                opacity: 1;
                transform: scale(1);
                filter: blur(0);
            }
        }

        /* --- LAYOUT & COMPONENTS --- */
        .intro {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: grid;
            place-items: center;
            background-color: var(--green);
            animation: intro 3s ease forwards;
            pointer-events: none; /* Allows clicking behind it after animation */
            will-change: opacity, transform, filter; /* Hardware acceleration */
        }

        .intro h1 {
            color: #F4EEE3;
            font-size: 150px;
            font-weight: 800;
            letter-spacing: 8px;
        }

        .text-gold {
            color: var(--gold);
        }

        main {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 120px 0;
            text-align: center;
            /* Fallback color if image loads slowly */
            background-color: #1a1a1a; 
            background: linear-gradient(#00000073, #00000073), url('/img/bg.jpeg') center / cover no-repeat;
            animation: zoom 2s ease 2s both;
            will-change: transform;
        }

        nav {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 30px 100px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            animation: reveal 1s ease 4s both;
        }

        nav p {
            color: #F4EEE3;
            font-size: 11px;
            letter-spacing: 4px;
        }

        .brand {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .content {
            width: 800px;
            height: 450px;
            padding: 50px;
            background: rgba(0, 0, 0, 0.24);
            border: 1px solid rgba(255, 255, 255, 0.19);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px); /* Safari support */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            animation: reveal 1.2s ease 3s both;
        }

        .content-subtitle {
            margin-bottom: 22px;
            color: var(--gold);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 6px;
            text-transform: uppercase;
        }

        .content h2 {
            margin-bottom: 22px;
            font-size: 80px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: 5px;
        }

        .content-description {
            width: 580px;
            margin: 0 auto 40px;
            color: rgba(255, 255, 255, 0.85);
            font-size: 14px;
            line-height: 2.1;
            letter-spacing: 0.5px;
        }

        .button-group {
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        /* --- BUTTON STYLING (Applied to <a> tags for SEO/Accessibility) --- */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 220px;
            padding: 18px 25px;
            text-decoration: none;
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: var(--gold);
            color: var(--green);
            border: 1px solid var(--gold);
        }

.btn-primary:hover,
.btn-primary:focus ,
.btn-outline:hover,
.btn-outline:focus {
background:
    radial-gradient(at 10% 10%, #fcf6ba 0%, transparent 30%),
    radial-gradient(at 90% 20%, #aa771c 0%, transparent 35%),
    radial-gradient(at 30% 80%, #fbf5b7 0%, transparent 40%),
    radial-gradient(at 70% 60%, #b38728 0%, transparent 45%),
    radial-gradient(at 45% 15%, #bf953f 0%, transparent 50%),
    linear-gradient(135deg, #8f6419, #bf953f, #aa771c);
    border-color: #b38728; 
    color: var(--green);
    transform: translateY(-3px);
    box-shadow: 0 5px 20px rgba(179, 135, 40, 0.45);
    outline: none;
}
        .btn-outline {
            background-color: transparent;
            color: white;
            border: 1px solid var(--gold);
        }


        footer {
            position: absolute;
            bottom: 35px;
            width: 100%;
            color: #F4EEE3;
            font-size: 10px;
            letter-spacing: 5px;
            text-align: center;
            animation: reveal 1s ease 4s both;
        }
    </style>
</head>

<body>

    <div class="intro" aria-hidden="true">
        <h1>AK <span class="text-gold">FABRICS</span></h1>
    </div>

    <main>
        <nav aria-label="Main Navigation">
            <div class="brand">
                AK <span class="text-gold">FABRICS</span>
            </div>
            <p>EST. WITH QUALITY</p>
        </nav>

        <section class="content">

            <p class="content-subtitle">
                Elegance in every thread
            </p>

            <h2>
                AK <span class="text-gold">FABRICS</span>
            </h2>

            <p class="content-description">
                Discover the perfect blend of quality, style and
                craftsmanship. Welcome to AK FABRICS, where every
                thread tells a story of excellence.
            </p>

            <div class="button-group">
                <!-- Changed to standard HTML links for production SEO and Accessibility -->
                <a href="/auth/signup" class="btn btn-primary" aria-label="Sign up for AK Fabrics">
                    SIGN UP
                </a>

                <a href="/collections" class="btn btn-outline" aria-label="Explore our fabric collections">
                    EXPLORE FABRICS
                </a>
            </div>

        </section>

        <footer>
            QUALITY &nbsp; • &nbsp; STYLE &nbsp; • &nbsp; ELEGANCE
        </footer>

    </main>

</body>
</html>
